# Copia este archivo como ".env" y rellena con los datos de tu proyecto

# Firebase (Auth + Firestore, plan gratuito Spark, sin tarjeta)
# console.firebase.google.com > Configuración del proyecto > Tus apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (fotos, plan gratuito, sin tarjeta)
# cloudinary.com > Dashboard (Cloud name) > Settings > Upload > Upload presets (crea uno "unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
